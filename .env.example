# Launch Radar configuration. Copy to .env and fill in.
# Get a Solami key (free Pro for 7 days): https://solami.dev/signup?ref=st-earn-sep-26
SOLAMI_API_KEY=

# Optional: Discord (or any) webhook for HIGH/CRITICAL alerts
WEBHOOK_URL=
ALERT_LEVEL=HIGH

# Optional overrides
# PORT=8787
# HOST=127.0.0.1
# LIGHT_MODE=0        # 1 = skip holder/creator lookups (default when no Solami key)
# TRAP_WATCH=1        # watch Token-2022 program for risky new mints
# RPC_URL=            # any Solana RPC (defaults to Solami, else public mainnet)
# WS_URL=
